}

// A utility lib that's local to recovery (in contrast, libotautil is exposed to device-specific
// recovery_ui lib as well as device-specific updater).

// Make a new static library for diagnostics tooling which can access
// other parts of recovery that may conatian device-specific codes
// (e.g., librecovery_ui)
cc_library_static {
    name: "librecovery_diagnostics",

    recovery_available: true,

    defaults: [
        "librecovery_diagnostics_defaults",
    ],

    srcs: [
        "read_dev.cpp",
    ],

    shared_libs: [
        "librecovery_ui",
    ],

    export_include_dirs: [
        "include",
    ],
}
